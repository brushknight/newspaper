#!/bin/sh
# Wi-Fi from newspaper-wifi.txt on the boot partition (the NEWSPAPER drive).
#
# At every start newspaper-wifi turns the file into /run/wpa_supplicant.conf
# (the SSID in hex, the password as its WPA key), then wpa_supplicant joins
# the network and udhcpc gets an address in the background. Nothing is
# written back to the card. Without a usable file the display shows its
# "No Wi-Fi connection" screen with what to do.

WIFI_TXT=/boot/newspaper-wifi.txt
CONF=/run/wpa_supplicant.conf
IFACE=wlan0

start() {
	printf "Starting Wi-Fi: "
	if ! /usr/bin/newspaper-wifi "$WIFI_TXT" "$CONF"; then
		echo "not configured (edit newspaper-wifi.txt on the NEWSPAPER drive)"
		return 0
	fi
	n=0
	while [ ! -e "/sys/class/net/$IFACE" ] && [ "$n" -lt 100 ]; do
		sleep 0.2 # brcmfmac loads its firmware after mdev's coldplug
		n=$((n + 1))
	done
	if [ ! -e "/sys/class/net/$IFACE" ]; then
		echo "no $IFACE"
		return 1
	fi
	ip link set "$IFACE" up
	wpa_supplicant -B -D nl80211 -i "$IFACE" -c "$CONF" -P /run/wpa_supplicant.pid
	udhcpc -b -S -i "$IFACE" -p /run/udhcpc.$IFACE.pid -x hostname:newspaper >/dev/null 2>&1
	echo "OK"
}

stop() {
	for p in /run/udhcpc.$IFACE.pid /run/wpa_supplicant.pid; do
		[ -f "$p" ] && kill "$(cat "$p")" 2>/dev/null
		rm -f "$p"
	done
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
