# SD card layout: FAT boot partition (firmware, kernel, newspaper-wifi.txt),
# read-only root file system, and a small data partition for the device token.

image boot.vfat {
	vfat {
		label = "NEWSPAPER"
		files = {
#BOOT_FILES#
		}
	}

	size = 32M
}

image data.ext4 {
	ext4 {
		label = "npdata"
	}

	size = 16M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
